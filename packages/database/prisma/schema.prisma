datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Tenant {
  id        String       @id @default(uuid()) @map("id") @db.Uuid
  name      String       @map("name") @db.VarChar(255)
  slug      String       @unique @map("slug") @db.VarChar(255)
  status    TenantStatus @default(ACTIVE) @map("status")
  version   Int          @default(1) @map("version")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid
  updatedBy String?      @map("updated_by") @db.Uuid

  users                     User[]                     @relation("TenantToUsers")
  roles                     Role[]                     @relation("TenantToRoles")
  sessions                  Session[]                  @relation("TenantToSessions")
  userRoles                 UserRole[]                 @relation("TenantToUserRoles")
  organizationSettings      OrganizationSettings?      @relation("TenantToOrganizationSettings")
  mediaFiles                MediaFile[]                @relation("TenantToMediaFiles")
  reportJobs                ReportJob[]                @relation("TenantToReportJobs")
  departments               Department[]               @relation("TenantToDepartments")
  designations              Designation[]              @relation("TenantToDesignations")
  units                     Unit[]                     @relation("TenantToUnits")
  categories                Category[]                 @relation("TenantToCategories")
  taxCategories             TaxCategory[]              @relation("TenantToTaxCategories")
  warehouses                Warehouse[]                @relation("TenantToWarehouses")
  products                  Product[]                  @relation("TenantToProducts")
  stocks                    Stock[]                    @relation("TenantToStocks")
  movements                 StockMovement[]            @relation("TenantToMovements")
  transfers                 StockTransfer[]            @relation("TenantToTransfers")
  adjustments               StockAdjustment[]          @relation("TenantToAdjustments")
  purchaseOrders            PurchaseOrder[]            @relation("TenantToPurchaseOrders")
  customers                 Customer[]                 @relation("TenantToCustomers")
  salesOrders               SalesOrder[]               @relation("TenantToSalesOrders")
  invoices                  Invoice[]                  @relation("TenantToInvoices")
  payments                  Payment[]                  @relation("TenantToPayments")
  accounts                  Account[]                  @relation("TenantToAccounts")
  journalEntries            JournalEntry[]             @relation("TenantToJournalEntries")
  journalEntryLines         JournalEntryLine[]         @relation("TenantToJournalEntryLines")
  financialPeriods          FinancialPeriod[]          @relation("TenantToFinancialPeriods")
  taxRules                  TaxRule[]                  @relation("TenantToTaxRules")
  taxExemptions             TaxExemption[]             @relation("TenantToTaxExemptions")
  taxTransactions           TaxTransaction[]           @relation("TenantToTaxTransactions")
  assetCategories           AssetCategory[]            @relation("TenantToAssetCategories")
  assets                    Asset[]                    @relation("TenantToAssets")
  assetDepreciations        AssetDepreciation[]        @relation("TenantToAssetDepreciations")
  assetTransfers            AssetTransfer[]            @relation("TenantToAssetTransfers")
  assetMaintenanceLogs      AssetMaintenance[]         @relation("TenantToAssetMaintenanceLogs")
  bankAccounts              BankAccount[]              @relation("TenantToBankAccounts")
  bankTransactions          BankTransaction[]          @relation("TenantToBankTransactions")
  bankReconciliations       BankReconciliation[]       @relation("TenantToBankReconciliations")
  bankReconciliationLines   BankReconciliationLine[]   @relation("TenantToReconciliationLines")
  budgets                   Budget[]                   @relation("TenantToBudgets")
  budgetItems               BudgetItem[]               @relation("TenantToBudgetItems")
  budgetRevisions           BudgetRevision[]           @relation("TenantToBudgetRevisions")
  budgetRevisionItems       BudgetRevisionItem[]       @relation("TenantToBudgetRevisionItems")
  leads                     Lead[]                     @relation("TenantToLeads")
  crmContacts               CRMContact[]               @relation("TenantToCRMContacts")
  crmAccounts               CRMAccount[]               @relation("TenantToCRMAccounts")
  opportunities             Opportunity[]              @relation("TenantToOpportunities")
  crmActivities             CRMActivity[]              @relation("TenantToCRMActivities")
  employees                 Employee[]                 @relation("TenantToEmployees")
  employeeDocuments         EmployeeDocument[]         @relation("TenantToEmployeeDocuments")
  attendancePolicies        AttendancePolicy[]         @relation("TenantToAttendancePolicies")
  shifts                    Shift[]                    @relation("TenantToShifts")
  shiftAssignments          ShiftAssignment[]          @relation("TenantToShiftAssignments")
  holidays                  Holiday[]                  @relation("TenantToHolidays")
  attendanceRecords         AttendanceRecord[]         @relation("TenantToAttendanceRecords")
  attendanceCorrections     AttendanceCorrection[]     @relation("TenantToAttendanceCorrections")
  leaveTypes                LeaveType[]                @relation("TenantToLeaveTypes")
  leavePolicies             LeavePolicy[]              @relation("TenantToLeavePolicies")
  leaveBalances             LeaveBalance[]             @relation("TenantToLeaveBalances")
  leaveRequests             LeaveRequest[]             @relation("TenantToLeaveRequests")
  leaveApprovals            LeaveApproval[]            @relation("TenantToLeaveApprovals")
  leaveAccruals             LeaveAccrualHistory[]      @relation("TenantToLeaveAccruals")
  leaveCarryForwards        LeaveCarryForwardHistory[] @relation("TenantToLeaveCarryForwards")
  salaryComponents          SalaryComponent[]          @relation("TenantToSalaryComponents")
  salaryStructures          SalaryStructure[]          @relation("TenantToSalaryStructures")
  salaryStructureComponents SalaryStructureComponent[] @relation("TenantToSalaryStructureComponents")
  salaryAssignments         EmployeeSalaryAssignment[] @relation("TenantToSalaryAssignments")
  payrollPeriods            PayrollPeriod[]            @relation("TenantToPayrollPeriods")
  payslips                  Payslip[]                  @relation("TenantToPayslips")
  expenseClaims             ExpenseClaim[]             @relation("TenantToExpenseClaims")
  expenseClaimItems         ExpenseClaimItem[]         @relation("TenantToExpenseClaimItems")
  expenseApprovals          ExpenseClaimApproval[]     @relation("TenantToExpenseApprovals")
  appraisalCycles           AppraisalCycle[]           @relation("TenantToAppraisalCycles")
  performanceGoals          PerformanceGoal[]          @relation("TenantToPerformanceGoals")
  performanceReviews        PerformanceReview[]        @relation("TenantToPerformanceReviews")
  announcements             CompanyAnnouncement[]      @relation("TenantToAnnouncements")
  passwordHistories         PasswordHistory[]          @relation("TenantToPasswordHistories")
  loginHistories            LoginHistory[]             @relation("TenantToLoginHistories")
  trustedDevices            TrustedDevice[]            @relation("TenantToTrustedDevices")
  securityEvents            SecurityEvent[]            @relation("TenantToSecurityEvents")
  workflowDefinitions       WorkflowDefinition[]       @relation("TenantToWorkflowDefinitions")
  workflowSteps             WorkflowStep[]             @relation("TenantToWorkflowSteps")
  workflowInstances         WorkflowInstance[]         @relation("TenantToWorkflowInstances")
  workflowInstanceSteps     WorkflowInstanceStep[]     @relation("TenantToWorkflowInstanceSteps")
  workflowDelegations       WorkflowDelegation[]       @relation("TenantToWorkflowDelegations")
  workCenters               WorkCenter[]               @relation("TenantToWorkCenters")
  boms                      BOM[]                      @relation("TenantToBOMs")
  bomItems                  BOMItem[]                  @relation("TenantToBOMItems")
  routings                  Routing[]                  @relation("TenantToRoutings")
  routingOperations         RoutingOperation[]         @relation("TenantToRoutingOperations")
  workOrders                WorkOrder[]                @relation("TenantToWorkOrders")
  workOrderOperations       WorkOrderOperation[]       @relation("TenantToWorkOrderOperations")
  samplingPlans             SamplingPlan[]             @relation("TenantToSamplingPlans")
  inspectionPlans           InspectionPlan[]           @relation("TenantToInspectionPlans")
  inspectionCharacteristics InspectionCharacteristic[] @relation("TenantToInspectionCharacteristics")
  inspectionLots            InspectionLot[]            @relation("TenantToInspectionLots")
  inspectionResults         InspectionResult[]         @relation("TenantToInspectionResults")
  qualityDefects            QualityDefect[]            @relation("TenantToQualityDefects")
  nonConformanceReports     NonConformanceReport[]     @relation("TenantToNCRs")
  correctiveActions         CorrectiveAction[]         @relation("TenantToCorrectiveActions")
  supplierQualityRatings    SupplierQualityRating[]    @relation("TenantToSupplierQualityRatings")
  qualityCertificates       QualityCertificate[]       @relation("TenantToQualityCertificates")
  warehouseZones            WarehouseZone[]            @relation("TenantToWarehouseZones")
  warehouseBins             WarehouseBin[]             @relation("TenantToWarehouseBins")
  binStock                  BinStock[]                 @relation("TenantToBinStock")
  putawayRules              PutawayRule[]              @relation("TenantToPutawayRules")
  warehouseMovements        WarehouseMovement[]        @relation("TenantToWmsMovements")
  cycleCounts               CycleCount[]               @relation("TenantToCycleCounts")
  cycleLines                CycleCountLine[]           @relation("TenantToCycleCountLines")
  vehicles                  Vehicle[]                  @relation("TenantToVehicles")
  drivers                   Driver[]                   @relation("TenantToDrivers")
  carriers                  Carrier[]                  @relation("TenantToCarriers")
  shipments                 Shipment[]                 @relation("TenantToShipments")
  trips                     Trip[]                     @relation("TenantToTrips")
  shipmentStops             ShipmentStop[]             @relation("TenantToShipmentStops")
  shipmentExceptions        ShipmentException[]        @relation("TenantToShipmentExceptions")
  fuelLogs                  FuelLog[]                  @relation("TenantToFuelLogs")
  maintenanceSchedules      MaintenanceSchedule[]      @relation("TenantToMaintenanceSchedules")
  gpsLogs                   GPSLog[]                   @relation("TenantToGPSLogs")
  ticketCategories          TicketCategory[]           @relation("TenantToTicketCategories")
  slaPolicies               SlaPolicy[]                @relation("TenantToSlaPolicies")
  serviceContracts          ServiceContract[]          @relation("TenantToServiceContracts")
  supportTickets            SupportTicket[]            @relation("TenantToSupportTickets")
  ticketNotes               TicketNote[]               @relation("TenantToTicketNotes")
  kbArticles                KbArticle[]                @relation("TenantToKbArticles")
  rmaRequests               RmaRequest[]               @relation("TenantToRmaRequests")
  serviceVisits             ServiceVisit[]             @relation("TenantToServiceVisits")
  companies                 Company[]                  @relation("TenantToCompanies")
  exchangeRates             ExchangeRate[]             @relation("TenantToExchangeRates")
  interCompanyTx            InterCompanyTransaction[]  @relation("TenantToInterCompanyTx")
  consolidations            ConsolidationRun[]         @relation("TenantToConsolidations")
  consolidatedReports       ConsolidatedReport[]       @relation("TenantToConsolidatedReports")
  companyPermissions        CompanyPermission[]        @relation("TenantToCompanyPermissions")

  @@index([slug])
  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @map("id") @db.Uuid
  email        String     @unique @map("email") @db.VarChar(255)
  username     String     @unique @map("username") @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE) @map("status")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  tenantId     String     @map("tenant_id") @db.Uuid
  version      Int        @default(1) @map("version")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid

  tenant                  Tenant                 @relation("TenantToUsers", fields: [tenantId], references: [id], onDelete: Cascade)
  sessions                Session[]              @relation("UserToSessions")
  userRoles               UserRole[]             @relation("UserToUserRoles")
  notifications           Notification[]         @relation("UserToNotifications")
  uploadedFiles           MediaFile[]            @relation("UserToUploadedFiles")
  reportJobs              ReportJob[]            @relation("UserToReportJobs")
  createdPOs              PurchaseOrder[]        @relation("UserToCreatedPOs")
  receivedReceipts        PurchaseReceipt[]      @relation("UserToPOReceipts")
  createdSOs              SalesOrder[]           @relation("UserToCreatedSOs")
  deliveredSales          SalesDelivery[]        @relation("UserToSalesDeliveries")
  createdInvoices         Invoice[]              @relation("UserToCreatedInvoices")
  createdPayments         Payment[]              @relation("UserToCreatedPayments")
  approvedBudgetRevisions BudgetRevision[]       @relation("UserApprovedRevisions")
  approvedCorrections     AttendanceCorrection[] @relation("UserApprovedCorrections")
  leaveApprovals          LeaveApproval[]        @relation("UserLeaveApprovals")
  expenseApprovals        ExpenseClaimApproval[] @relation("UserExpenseApprovals")
  passwordHistories       PasswordHistory[]
  loginHistories          LoginHistory[]
  trustedDevices          TrustedDevice[]
  securityEvents          SecurityEvent[]
  initiatedWorkflows      WorkflowInstance[]     @relation("UserInitiatedWorkflows")
  assignedWorkflowSteps   WorkflowInstanceStep[] @relation("UserAssignedWorkflowSteps")
  actionedWorkflowSteps   WorkflowInstanceStep[] @relation("UserActionedWorkflowSteps")
  delegationsFrom         WorkflowDelegation[]   @relation("UserDelegationsFrom")
  delegationsTo           WorkflowDelegation[]   @relation("UserDelegationsTo")
  initiatedWorkOrders     WorkOrder[]            @relation("UserInitiatedWorkOrders")
  assignedCAPAs           CorrectiveAction[]     @relation("UserAssignedCAPAs")
  certifiedCOAs           QualityCertificate[]   @relation("UserCertifiedCOAs")
  inspectedResults        InspectionResult[]     @relation("UserInspectedResults")
  wmsMovements            WarehouseMovement[]    @relation("UserToWmsMovements")
  cycleCounts             CycleCount[]           @relation("UserToCycleCounts")
  assignedTickets         SupportTicket[]        @relation("AgentTickets")
  ticketNotes             TicketNote[]           @relation("UserTicketNotes")
  serviceVisits           ServiceVisit[]         @relation("TechnicianVisits")
  companyPermissions      CompanyPermission[]    @relation("UserToCompanyPermissions")

  emailVerified               Boolean   @default(false) @map("email_verified")
  verificationToken           String?   @map("verification_token") @db.VarChar(255)
  verificationTokenExpiresAt  DateTime? @map("verification_token_expires_at") @db.Timestamptz
  resetPasswordToken          String?   @map("reset_password_token") @db.VarChar(255)
  resetPasswordTokenExpiresAt DateTime? @map("reset_password_token_expires_at") @db.Timestamptz
  mfaEnabled                  Boolean   @default(false) @map("mfa_enabled")
  mfaSecret                   String?   @map("mfa_secret") @db.VarChar(255)
  mfaRecoveryCodes            String[]  @map("mfa_recovery_codes")
  passwordChangedAt           DateTime? @map("password_changed_at") @db.Timestamptz
  failedLoginAttempts         Int       @default(0) @map("failed_login_attempts")
  lockedUntil                 DateTime? @map("locked_until") @db.Timestamptz
  passwordExpiresAt           DateTime? @map("password_expires_at") @db.Timestamptz
  pendingEmail                String?   @map("pending_email") @db.VarChar(255)
  emailChangeToken            String?   @map("email_change_token") @db.VarChar(255)
  emailChangeTokenExpires     DateTime? @map("email_change_token_expires") @db.Timestamptz

  @@index([email])
  @@index([username])
  @@index([tenantId])
  @@index([deletedAt])
  @@index([verificationToken])
  @@index([resetPasswordToken])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @map("id") @db.Uuid
  name        String    @map("name") @db.VarChar(255)
  description String?   @map("description") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  isSystem    Boolean   @default(false) @map("is_system")
  tenantId    String    @map("tenant_id") @db.Uuid
  version     Int       @default(1) @map("version")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  tenant          Tenant           @relation("TenantToRoles", fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[] @relation("RoleToRolePermissions")
  userRoles       UserRole[]       @relation("RoleToUserRoles")

  @@unique([name, tenantId])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @map("id") @db.Uuid
  name        String    @unique @map("name") @db.VarChar(255)
  description String?   @map("description") @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  version     Int       @default(1) @map("version")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  rolePermissions RolePermission[] @relation("PermissionToRolePermissions")

  @@index([name])
  @@index([deletedAt])
  @@map("permissions")
}

model Session {
  id             String    @id @default(uuid()) @map("id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  accessTokenId  String    @unique @map("access_token_id") @db.Uuid
  refreshTokenId String    @unique @map("refresh_token_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.Text
  version        Int       @default(1) @map("version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  user   User   @relation("UserToSessions", fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation("TenantToSessions", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([accessTokenId])
  @@index([refreshTokenId])
  @@index([deletedAt])
  @@map("sessions")
}

model UserRole {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  version   Int       @default(1) @map("version")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  user   User   @relation("UserToUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation("RoleToUserRoles", fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation("TenantToUserRoles", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("user_roles")
}

model RolePermission {
  id           String    @id @default(uuid()) @map("id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  version      Int       @default(1) @map("version")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid

  role       Role       @relation("RoleToRolePermissions", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("PermissionToRolePermissions", fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  entity    String   @map("entity") @db.VarChar(255)
  entityId  String?  @map("entity_id") @db.VarChar(255)
  action    String   @map("action") @db.VarChar(255)
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  requestId String?  @map("request_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OrganizationSettings {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  companyName     String?  @map("company_name") @db.VarChar(255)
  legalName       String?  @map("legal_name") @db.VarChar(255)
  logoUrl         String?  @map("logo_url") @db.VarChar(2048)
  website         String?  @map("website") @db.VarChar(255)
  email           String?  @map("email") @db.VarChar(255)
  phone           String?  @map("phone") @db.VarChar(50)
  taxNumber       String?  @map("tax_number") @db.VarChar(50)
  currency        String?  @map("currency") @db.VarChar(10)
  timezone        String?  @map("timezone") @db.VarChar(100)
  fiscalYearStart String?  @map("fiscal_year_start") @db.VarChar(50)
  address         String?  @map("address") @db.Text
  city            String?  @map("city") @db.VarChar(100)
  state           String?  @map("state") @db.VarChar(100)
  postalCode      String?  @map("postal_code") @db.VarChar(20)
  country         String?  @map("country") @db.VarChar(100)
  version         Int      @default(1) @map("version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation("TenantToOrganizationSettings", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("organization_settings")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        String           @id @default(uuid()) @map("id") @db.Uuid
  tenantId  String?          @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @map("title") @db.VarChar(255)
  message   String           @map("message") @db.Text
  type      NotificationType @default(INFO) @map("type")
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?            @map("metadata")
  version   Int              @default(1) @map("version")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  readAt    DateTime?        @map("read_at") @db.Timestamptz

  user User @relation("UserToNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum MediaFileType {
  IMAGE
  DOCUMENT
  PDF
  VIDEO
  AUDIO
  ARCHIVE
  OTHER
}

model MediaFile {
  id              String        @id @default(uuid()) @map("id") @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  uploadedBy      String        @map("uploaded_by") @db.Uuid
  originalName    String        @map("original_name") @db.VarChar(255)
  storedName      String        @map("stored_name") @db.VarChar(255)
  mimeType        String        @map("mime_type") @db.VarChar(100)
  extension       String        @map("extension") @db.VarChar(20)
  size            Int           @map("size")
  type            MediaFileType @map("type")
  storageProvider String        @map("storage_provider") @db.VarChar(50)
  storagePath     String        @map("storage_path") @db.Text
  checksum        String        @map("checksum") @db.VarChar(255)
  isPublic        Boolean       @default(false) @map("is_public")
  version         Int           @default(1) @map("version")
