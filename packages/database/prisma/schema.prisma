  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  logs IntegrationApiLog[] @relation("ApiKeyToApiLogs")

  @@unique([tenantId, hashedKey])
  @@index([tenantId])
  @@map("integration_api_keys")
}

model IntegrationWebhookEndpoint {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  url       String   @map("url") @db.VarChar(512)
  secret    String   @map("secret") @db.VarChar(255)
  events    Json     @map("events")
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1) @map("version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  deliveries IntegrationWebhookDelivery[] @relation("EndpointToWebhookDeliveries")

  @@index([tenantId])
  @@map("integration_webhook_endpoints")
}

model IntegrationWebhookDelivery {
  id                 String    @id @default(uuid()) @map("id") @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  endpointId         String    @map("endpoint_id") @db.Uuid
  event              String    @map("event") @db.VarChar(100)
  payload            Json      @map("payload")
  status             String    @map("status") @db.VarChar(50)
  responseStatusCode Int?      @map("response_status_code")
  responseBody       String?   @map("response_body") @db.Text
  retryCount         Int       @default(0) @map("retry_count")
  lastAttemptAt      DateTime? @map("last_attempt_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  endpoint IntegrationWebhookEndpoint @relation("EndpointToWebhookDeliveries", fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("integration_webhook_deliveries")
}

model IntegrationConfig {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  provider    String   @map("provider") @db.VarChar(100)
  credentials Json     @map("credentials")
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1) @map("version")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("integration_configs")
}

model IntegrationApiLog {
  id             String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  apiKeyId       String?  @map("api_key_id") @db.Uuid
  method         String   @map("method") @db.VarChar(10)
  path           String   @map("path") @db.VarChar(255)
  statusCode     Int      @map("status_code")
  responseTimeMs Int      @map("response_time_ms")
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  apiKey IntegrationApiKey? @relation("ApiKeyToApiLogs", fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("integration_api_logs")
}

enum InterCompanyType {
  SALE_PURCHASE
  INVENTORY_TRANSFER
  SETTLEMENT
  FUNDS_TRANSFER
}

enum InterCompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

enum ConsolidationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ConsolidatedReportType {
  BALANCE_SHEET
  PROFIT_AND_LOSS
  CASH_FLOW
}

model Company {
  id                    String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  parentId              String?  @map("parent_id") @db.Uuid
  name                  String   @map("name") @db.VarChar(255)
  code                  String   @map("code") @db.VarChar(50)
  legalName             String   @map("legal_name") @db.VarChar(255)
  taxId                 String?  @map("tax_id") @db.VarChar(100)
  baseCurrency          String   @map("base_currency") @db.VarChar(10)
  country               String   @map("country") @db.VarChar(100)
  isConsolidationEntity Boolean  @default(false) @map("is_consolidation_entity")
  version               Int      @default(1) @map("version")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant                    @relation("TenantToCompanies", fields: [tenantId], references: [id], onDelete: Cascade)
  parent            Company?                  @relation("CompanyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries      Company[]                 @relation("CompanyHierarchy")
  journalEntries    JournalEntry[]            @relation("CompanyToJournalEntries")
  salesOrders       SalesOrder[]              @relation("CompanyToSalesOrders")
  purchaseOrders    PurchaseOrder[]           @relation("CompanyToPurchaseOrders")
  invoices          Invoice[]                 @relation("CompanyToInvoices")
  payments          Payment[]                 @relation("CompanyToPayments")
  warehouses        Warehouse[]               @relation("CompanyToWarehouses")
  permissions       CompanyPermission[]       @relation("CompanyToPermissions")
  incomingTx        InterCompanyTransaction[] @relation("IncomingInterCompany")
  outgoingTx        InterCompanyTransaction[] @relation("OutgoingInterCompany")
  consolidationRuns ConsolidationRun[]        @relation("CompanyToConsolidations")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("companies")
}

model ExchangeRate {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fromCurrency String   @map("from_currency") @db.VarChar(10)
  toCurrency   String   @map("to_currency") @db.VarChar(10)
  rate         Decimal  @map("rate") @db.Decimal(18, 6)
  rateDate     DateTime @map("rate_date") @db.Timestamptz
  version      Int      @default(1) @map("version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation("TenantToExchangeRates", fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromCurrency, toCurrency, rateDate])
  @@index([tenantId])
  @@map("exchange_rates")
}

model InterCompanyTransaction {
  id                    String             @id @default(uuid()) @map("id") @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  fromCompanyId         String             @map("from_company_id") @db.Uuid
  toCompanyId           String             @map("to_company_id") @db.Uuid
  type                  InterCompanyType   @map("type")
  status                InterCompanyStatus @default(PENDING) @map("status")
  amount                Decimal            @map("amount") @db.Decimal(12, 4)
  currency              String             @map("currency") @db.VarChar(10)
  referenceType         String?            @map("reference_type") @db.VarChar(100)
  referenceId           String?            @map("reference_id") @db.Uuid
  eliminated            Boolean            @default(false) @map("eliminated")
  eliminationId         String?            @map("elimination_id") @db.Uuid
  transferPricingMarkup Decimal            @default(0) @map("transfer_pricing_markup") @db.Decimal(5, 2)
  version               Int                @default(1) @map("version")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant  @relation("TenantToInterCompanyTx", fields: [tenantId], references: [id], onDelete: Cascade)
  fromCompany Company @relation("OutgoingInterCompany", fields: [fromCompanyId], references: [id], onDelete: Restrict)
  toCompany   Company @relation("IncomingInterCompany", fields: [toCompanyId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@map("inter_company_transactions")
}

model ConsolidationRun {
  id              String              @id @default(uuid()) @map("id") @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  parentCompanyId String              @map("parent_company_id") @db.Uuid
  startDate       DateTime            @map("start_date") @db.Timestamptz
  endDate         DateTime            @map("end_date") @db.Timestamptz
  status          ConsolidationStatus @default(PENDING) @map("status")
  runBy           String              @map("run_by") @db.Uuid
  version         Int                 @default(1) @map("version")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant               @relation("TenantToConsolidations", fields: [tenantId], references: [id], onDelete: Cascade)
  parentCompany Company              @relation("CompanyToConsolidations", fields: [parentCompanyId], references: [id], onDelete: Restrict)
  reports       ConsolidatedReport[] @relation("ConsolidationToReports")

  @@index([tenantId])
  @@map("consolidation_runs")
}

model ConsolidatedReport {
  id                 String                 @id @default(uuid()) @map("id") @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  consolidationRunId String                 @map("consolidation_run_id") @db.Uuid
  reportType         ConsolidatedReportType @map("report_type")
  periodName         String                 @map("period_name") @db.VarChar(100)
  currency           String                 @map("currency") @db.VarChar(10)
  data               Json                   @map("data")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant           @relation("TenantToConsolidatedReports", fields: [tenantId], references: [id], onDelete: Cascade)
  run    ConsolidationRun @relation("ConsolidationToReports", fields: [consolidationRunId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("consolidated_reports")
}

model CompanyPermission {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation("TenantToCompanyPermissions", fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation("UserToCompanyPermissions", fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation("CompanyToPermissions", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, companyId, roleId])
  @@index([tenantId])
  @@map("company_permissions")
}
